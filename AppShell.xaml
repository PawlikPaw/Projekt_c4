<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Projekt_c4.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Projekt_c4.Views"
    Shell.TabBarBackgroundColor="#16181F"
    Shell.TabBarTitleColor="#00E676"
    Shell.TabBarUnselectedColor="#555555"
    Shell.TabBarForegroundColor="#00E676"
    Title="Runnner">

    <TabBar>
        <!-- ZAKŁADKA 1: EKRAN BIEGANIA -->
        <Tab x:Name="RunningTab" Route="RunningTab" Title="Run" Icon="runactive.png">
            <ShellContent ContentTemplate="{DataTemplate views:RunningPage}" />
        </Tab>

        <!-- ZAKŁADKA 2: TRASY -->
        <Tab x:Name="RoutesTab" Route="RoutesTab" Title="Trasy" Icon="routesinactive.png">
            <ShellContent ContentTemplate="{DataTemplate views:SavedRoutesPage}" />
        </Tab>

        <!-- ZAKŁADKA 3: WYSZUKIWANIE BIEGACZY -->
        <Tab x:Name="SearchTab" Route="SearchTab" Title="Szukaj" Icon="searchinactive.png">
            <ShellContent ContentTemplate="{DataTemplate views:SearchPage}" />
        </Tab>

        <!-- ZAKŁADKA 4: PROFIL / HISTORIA (DAWNY MAINPAGE) -->
        <Tab x:Name="ProfileTab" Route="ProfileTab" Title="Profil" Icon="profileinactive.png">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" />
        </Tab>
    </TabBar>

</Shell>

<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Projekt_c4.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Projekt_c4.Views"
    Shell.TabBarBackgroundColor="#16181F"
    Shell.TabBarTitleColor="#00E676"
    Shell.TabBarUnselectedColor="#555555"
    Title="Runnner">

    <TabBar>
        <!-- ZAKŁADKA 1: EKRAN BIEGANIA -->
        <Tab Route="RunningTab" Title="Run" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:RunningPage}" />
        </Tab>

        <!-- NOWA ZAKŁADKA: TRASY -->
        <Tab Route="RoutesTab" Title="Trasy" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:SavedRoutesPage}" />
        </Tab>

        <!-- ZAKŁADKA 3: PROFIL / HISTORIA (DAWNY MAINPAGE) -->
        <Tab x:Name="ProfileTab" Route="ProfileTab" Title="Profil" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" />
        </Tab>
    </TabBar>

</Shell>

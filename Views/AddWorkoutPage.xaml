<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projekt_c4.Views.AddWorkoutPage"
             Title="Nowy Trening">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Szczegóły treningu" FontSize="22" FontAttributes="Bold" />

            <Entry Placeholder="Nazwa treningu (np. Plecy i Biceps)"
                   FontSize="16" />

            <DatePicker FontSize="16" />

            <BoxView HeightRequest="1" Color="Gray" Opacity="0.3" Margin="0,10" />

            <Label Text="W przyszłości dodamy tu listę wybierania ćwiczeń..."
                   TextColor="LightGray"
                   HorizontalOptions="Center"
                   Margin="0,20"/>

            <Button Text="Zapisz trening"
                    CornerRadius="8"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontAttributes="Bold"
                    Margin="0,20,0,0"
                    Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projekt_c4.Views.ExercisesDatabasePage"
             Title="Baza Ćwiczeń">

    <Grid RowDefinitions="Auto, *">
        <SearchBar Grid.Row="0" Placeholder="Szukaj ćwiczenia..." Margin="10" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="10">

                <Label Text="Mięśnie klatki piersiowej" FontSize="16" FontAttributes="Bold" TextColor="#2196F3" Margin="0,10,0,0"/>
                <Button Text="Wyciskanie sztangi leżąc" HorizontalOptions="Fill" BackgroundColor="#1E1E1E" TextColor="White" />
                <Button Text="Rozpiętki na maszynie" HorizontalOptions="Fill" BackgroundColor="#1E1E1E" TextColor="White" />

                <Label Text="Mięśnie pleców" FontSize="16" FontAttributes="Bold" TextColor="#2196F3" Margin="0,15,0,0"/>
                <Button Text="Podciąganie na drążku" HorizontalOptions="Fill" BackgroundColor="#1E1E1E" TextColor="White" />
                <Button Text="Wiosłowanie hantlem" HorizontalOptions="Fill" BackgroundColor="#1E1E1E" TextColor="White" />

                <Label Text="Nogi" FontSize="16" FontAttributes="Bold" TextColor="#2196F3" Margin="0,15,0,0"/>
                <Button Text="Przysiady ze sztangą" HorizontalOptions="Fill" BackgroundColor="#1E1E1E" TextColor="White" />
                <Button Text="Wykroki" HorizontalOptions="Fill" BackgroundColor="#1E1E1E" TextColor="White" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Projekt_c4.ViewModels"
             x:Class="Projekt_c4.Views.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#16181F">

    <ContentPage.BindingContext>
        <viewmodels:MainViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- WIDOK LOGOWANIA -->
        <Grid x:Name="LoginView" Padding="20,40,20,20" IsVisible="True" BackgroundColor="#16181F" ZIndex="10">
            <VerticalStackLayout VerticalOptions="Center" Spacing="25">
                <Label Text="🏃" FontSize="60" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Label Text="Zaloguj się" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                <Label Text="aby śledzić swoje treningi" FontSize="16" TextColor="#888" HorizontalOptions="Center" Margin="0,-15,0,20"/>

                <Entry Placeholder="Adres e-mail" PlaceholderColor="#888" TextColor="White" BackgroundColor="#222731" />
                <Entry Placeholder="Hasło" IsPassword="True" PlaceholderColor="#888" TextColor="White" BackgroundColor="#222731" />

                <Button Text="ZALOGUJ" CornerRadius="25" HeightRequest="55" BackgroundColor="#00E676" TextColor="Black" FontAttributes="Bold" FontSize="16" Clicked="OnLoginClicked" Margin="0,15,0,0"/>

                <Label Text="Nie masz konta? Zarejestruj się." TextColor="#00E676" HorizontalOptions="Center" FontSize="14" Margin="0,15,0,0"/>
            </VerticalStackLayout>
        </Grid>

        <!-- GŁÓWNY WIDOK PROFILU (Pokazuje się po zalogowaniu) -->
        <Grid x:Name="ProfileView" RowDefinitions="Auto, *, Auto" Padding="20,40,20,20" IsVisible="False" ZIndex="5">

            <!-- NAGŁÓWEK / PROFIL UŻYTKOWNIKA -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,30">
                <Frame Grid.Column="0" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#222731" Padding="0" HasShadow="False" BorderColor="Transparent">
                    <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="30"/>
                </Frame>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0">
                    <Label Text="Witaj, Biegaczu!" FontSize="24" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Gotowy na bicie rekordów?" FontSize="14" TextColor="#00E676"/>
                </VerticalStackLayout>
            </Grid>

            <!-- HISTORIA TRENINGÓW -->
            <VerticalStackLayout Grid.Row="1" Spacing="15">
                <Label Text="Ostatnie Aktywności Siłowe" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="0,0,0,10"/>

                <CollectionView ItemsSource="{Binding Workouts}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,0,0,15" Padding="0" CornerRadius="20" BackgroundColor="#1A1D24" HasShadow="False" BorderColor="Transparent">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWorkoutTapped" />
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="*, Auto" Padding="20">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                                        <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" TextColor="#888" Margin="0,5,0,0"/>
                                    </VerticalStackLayout>

                                    <Frame Grid.Column="1" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#222731" Padding="0" BorderColor="Transparent">
                                        <Label Text="💪" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18"/>
                                    </Frame>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- PRZYCISK DODAWANIA TRENINGU SIŁOWEGO -->
            <Button Grid.Row="2"
                    Text="+ NOWY TRENING SIŁOWY"
                    CornerRadius="25"
                    HeightRequest="55"
                    BackgroundColor="#00E676"
                    TextColor="Black"
                    FontAttributes="Bold"
                    FontSize="16"
                    Clicked="OnAddWorkoutClicked"/>
        </Grid>
    </Grid>
</ContentPage>
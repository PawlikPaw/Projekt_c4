<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="Projekt_c4.Views.RouteDetailsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#16181F">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- GÓRNY PASEK Z PRZYCISKIEM POWROTU -->
        <Grid Grid.Row="0" Margin="15,40,15,15" ColumnDefinitions="Auto, *">
            <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#1A1D24" Padding="0" HasShadow="False" BorderColor="Transparent">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Frame.GestureRecognizers>
                <Label Text="←" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="20" FontAttributes="Bold"/>
            </Frame>
            <Label x:Name="TitleLabel" Grid.Column="1" Text="Szczegóły trasy" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" FontSize="20" Margin="-40,0,0,0" />
        </Grid>

        <!-- MAPA Z WYRYSOWANĄ TRASĄ I PINEZKAMI -->
        <maps:Map x:Name="RouteMap" Grid.Row="1" MapType="Street" IsShowingUser="False"/>

        <!-- STATYSTYKI TRENINGU (DOLNY PANEL) -->
        <Frame Grid.Row="2" BackgroundColor="#1A1D24" CornerRadius="20" Margin="0,-20,0,0" Padding="20" HasShadow="True" BorderColor="Transparent">
            <Grid ColumnDefinitions="*,*,*">
                <!-- Dystans -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label x:Name="DistanceLabel" Text="0.00" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Dystans (km)" FontSize="12" TextColor="#888" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Czas trwania -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label x:Name="DurationLabel" Text="00:00" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Czas" FontSize="12" TextColor="#888" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Średnie Tempo -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label x:Name="PaceLabel" Text="00'00&quot;" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Tempo" FontSize="12" TextColor="#888" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
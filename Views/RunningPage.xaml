<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="Projekt_c4.Views.RunningPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#16181F">

    <Grid>
        <!-- PRAWIDZIWA MAPA Z LOKALIZACJĄ -->
        <maps:Map x:Name="RunMap" IsShowingUser="False" MapType="Street" ZIndex="1" />

        <Grid RowDefinitions="Auto, *" ZIndex="2">
            <!-- GÓRNY PASEK (TYLKO IKONA PROFILU) -->
            <Grid Grid.Row="0" Margin="15,40,15,0" ZIndex="10">
                <Frame HorizontalOptions="Start" WidthRequest="45" HeightRequest="45" CornerRadius="22" BackgroundColor="#1A1D24" Padding="0" HasShadow="True" BorderColor="Transparent">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileIconTapped" />
                    </Frame.GestureRecognizers>
                    <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
                </Frame>
            </Grid>

            <!-- ZWIJANY DOLNY PANEL STATYSTYK -->
            <Frame x:Name="BottomPanel" Grid.Row="1" BackgroundColor="#1A1D24" CornerRadius="30" Margin="0,0,0,-40" Padding="25" VerticalOptions="End" HasShadow="True" BorderColor="Transparent">

                <!-- Gesty Pan dla całego panelu, zapewniające natychmiastową reakcję -->
                <Frame.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </Frame.GestureRecognizers>

                <VerticalStackLayout Spacing="15">

                    <!-- Uchwyt (Drag handle) -->
                    <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" Color="#444" HorizontalOptions="Center" Margin="0,0,0,20"/>

                    <!-- Ten kontener będzie ukrywany przez animację TranslateTo panelu (suwanie z dołu) -->
                    <VerticalStackLayout x:Name="StatsContent">
                        <!-- Główne liczby -->
                        <Grid ColumnDefinitions="*, *">
                            <!-- Dystans -->
                            <VerticalStackLayout Grid.Column="0">
                                <Label x:Name="DistanceLabel" Text="00.00" FontSize="65" FontAttributes="Bold" TextColor="White" />
                                <Label Text="km" FontSize="24" FontAttributes="Bold" TextColor="#00E676" Margin="0,-15,0,0" />
                            </VerticalStackLayout>

                            <!-- Czas i Tempo -->
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                                <Label x:Name="DurationLabel" Text="00:00" FontSize="40" FontAttributes="Bold" TextColor="White" HorizontalOptions="End" />
                                <Label Text="Duration" FontSize="14" TextColor="#888" HorizontalOptions="End" Margin="0,-5,0,15"/>

                                <Label x:Name="PaceLabel" Text="00'00&quot;" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="End" />
                                <Label Text="Avg Pace" FontSize="12" TextColor="#888" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Elegancka Karta Kroków (Przeprojektowana) -->
                        <Frame BackgroundColor="#222731" CornerRadius="25" Padding="20" HasShadow="True" BorderColor="Transparent" Margin="0,20,0,0">
                            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                <Frame Grid.Column="0" BackgroundColor="#1A1D24" CornerRadius="25" WidthRequest="50" HeightRequest="50" Padding="0" HasShadow="False" BorderColor="Transparent" VerticalOptions="Center">
                                    <Label Text="👟" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0">
                                    <Label x:Name="StepsLabel" Text="0" FontSize="32" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="Kroki dzisiaj" FontSize="12" TextColor="#888" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                    <Label Text="Cel:" FontSize="12" TextColor="#555" HorizontalOptions="End"/>
                                    <Label Text="10 000" FontSize="14" FontAttributes="Bold" TextColor="#00E676" HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Przycisk Start/Stop nie zwija się, zawsze jest widoczny! -->
                    <Button x:Name="ActionBtn"
                            Text="START"
                            BackgroundColor="#00E676"
                            TextColor="Black"
                            FontAttributes="Bold"
                            FontSize="18"
                            CornerRadius="30"
                            HeightRequest="60"
                            Margin="0,20,0,20"
                            Clicked="OnActionClicked" />

                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
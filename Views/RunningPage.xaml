<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projekt_c4.Views.RunningPage"
             Title="Bieg"
             BackgroundColor="#121212">

    <Grid RowDefinitions="*, Auto">

        <!-- Tu w przyszłości wstawimy kontrolkę Mapy (Microsoft.Maui.Controls.Maps) -->
        <Frame Grid.Row="0" Margin="15" CornerRadius="15" BackgroundColor="#2A2A2A" BorderColor="#444">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="dotnet_bot.png" HeightRequest="100" Opacity="0.3" Margin="0,0,0,20"/>
                <Label Text="Miejsce na Mapę (GPS)"
                       TextColor="#888"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Frame>

        <!-- Panel nawigacyjny ze stoperem -->
        <Frame Grid.Row="1" BackgroundColor="#1E1E1E" CornerRadius="30" Margin="0,-20,0,0" Padding="20">
            <VerticalStackLayout Spacing="15">

                <Grid ColumnDefinitions="*, *, *">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label Text="0.00" FontSize="32" FontAttributes="Bold" TextColor="White" />
                        <Label Text="KILOMETRY" FontSize="12" TextColor="LightGray" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="00:00" FontSize="32" FontAttributes="Bold" TextColor="White" />
                        <Label Text="CZAS" FontSize="12" TextColor="LightGray" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                        <Label Text="0.0" FontSize="32" FontAttributes="Bold" TextColor="White" />
                        <Label Text="TEMPO (MIN/KM)" FontSize="12" TextColor="LightGray" />
                    </VerticalStackLayout>
                </Grid>

                <Button Text="ROZPOCZNIJ BIEG"
                        CornerRadius="25"
                        HeightRequest="50"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18"
                        Margin="0,15,0,0"
                        Clicked="OnStartRunClicked"/>
            </VerticalStackLayout>
        </Frame>

    </Grid>
</ContentPage>
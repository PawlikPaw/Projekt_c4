<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="Projekt_c4.Views.RunningPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#16181F">

    <Grid>
        <!-- PRAWIDZIWA MAPA -->
        <maps:Map x:Name="RunMap" IsShowingUser="True" MapType="Street" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All"/>

        <Grid RowDefinitions="Auto, *">
            <!-- GÓRNY PASEK (NAŁOŻONY NA MAPĘ) -->
            <Grid Grid.Row="0" Margin="15,40,15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#1E1E1E" Padding="0" HasShadow="False" BorderColor="Transparent">
                    <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18"/>
                </Frame>

                <Label Grid.Column="1" Text="Outdoor Run" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Black" FontAttributes="Bold" FontSize="20" />

                <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="5" BackgroundColor="#DD000000" Padding="10,5">
                    <Label Text="◎" TextColor="#00E676" FontSize="18" VerticalOptions="Center"/>
                    <Label Text="GPS" TextColor="#00E676" FontSize="16" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- ZWIJANY DOLNY PANEL STATYSTYK -->
            <Frame x:Name="BottomPanel" Grid.Row="1" BackgroundColor="#1A1D24" CornerRadius="30" Margin="0,0,0,-40" Padding="25" VerticalOptions="End" HasShadow="True" BorderColor="Transparent">

                <!-- Gesty Pan dla całego panelu, zapewniające natychmiastową reakcję -->
                <Frame.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </Frame.GestureRecognizers>

                <VerticalStackLayout Spacing="15">

                    <!-- Uchwyt (Drag handle) -->
                    <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" Color="#444" HorizontalOptions="Center" Margin="0,0,0,20"/>

                    <!-- Ten kontener będzie ukrywany przez animację TranslateTo panelu (suwanie z dołu) -->
                    <VerticalStackLayout x:Name="StatsContent">
                        <!-- Główne liczby -->
                        <Grid ColumnDefinitions="*, *">
                            <!-- Dystans -->
                            <VerticalStackLayout Grid.Column="0">
                                <Label x:Name="DistanceLabel" Text="00.00" FontSize="65" FontAttributes="Bold" TextColor="White" />
                                <Label Text="km" FontSize="24" FontAttributes="Bold" TextColor="#00E676" Margin="0,-15,0,0" />
                            </VerticalStackLayout>

                            <!-- Czas i Tempo -->
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                                <Label x:Name="DurationLabel" Text="00:00" FontSize="40" FontAttributes="Bold" TextColor="White" HorizontalOptions="End" />
                                <Label Text="Duration" FontSize="14" TextColor="#888" HorizontalOptions="End" Margin="0,-5,0,15"/>

                                <Label x:Name="PaceLabel" Text="00'00&quot;" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="End" />
                                <Label Text="Avg Pace" FontSize="12" TextColor="#888" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Karta Kroków -->
                        <Frame BackgroundColor="#222731" CornerRadius="25" Padding="20" HasShadow="False" BorderColor="Transparent" Margin="0,20,0,0">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" Text="Steps" TextColor="#888" FontSize="14" VerticalOptions="Start"/>

                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="👟" FontSize="32" HorizontalOptions="Center" Margin="0,0,0,10"/>
                                    <Label x:Name="StepsLabel" Text="0" FontSize="40" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                    <Label Text="steps" FontSize="14" TextColor="#888" HorizontalOptions="Center"/>
                                    <Label Text="Goal: 10,000" FontSize="12" TextColor="#555" HorizontalOptions="Center" Margin="0,5,0,0"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Przycisk Start/Stop nie zwija się, zawsze jest widoczny! -->
                    <Button x:Name="ActionBtn"
                            Text="START"
                            BackgroundColor="#00E676"
                            TextColor="Black"
                            FontAttributes="Bold"
                            FontSize="18"
                            CornerRadius="30"
                            HeightRequest="60"
                            Margin="0,20,0,20"
                            Clicked="OnActionClicked" />

                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
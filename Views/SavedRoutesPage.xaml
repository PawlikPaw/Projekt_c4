<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Projekt_c4.ViewModels"
             x:Class="Projekt_c4.Views.SavedRoutesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#16181F">

    <ContentPage.BindingContext>
        <viewmodels:MainViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *">
        <Label Grid.Row="0" Text="Zapisane Trasy" FontSize="26" FontAttributes="Bold" TextColor="White" Margin="20,40,20,10"/>

        <!-- Wyleciało zbugowane SelectionMode z CollectionView. Celowanie naprawione przez rzucenie twardego Click-targetu na całą ramkę (Frame)! -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Workouts}" Margin="20,0,20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5,0,10" Padding="0" CornerRadius="20" BackgroundColor="#1A1D24" HasShadow="True" BorderColor="#2A2D34">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRouteTapped" CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <!-- Upiększony wygląd karty biegów, Gradient i ikonki (Deluxe) -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="20">
                            <!-- Ikona trasy po lewej -->
                            <Frame Grid.Column="0" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#222731" Padding="0" HasShadow="False" BorderColor="Transparent" VerticalOptions="Center">
                                <Label Text="📍" HorizontalOptions="Center" VerticalOptions="Center" FontSize="22"/>
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0">
                                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy, HH:mm}'}" TextColor="#888" FontSize="12" Margin="0,3,0,0"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center">
                                <Label Text="{Binding DistanceKm, StringFormat='{0:F2} km'}" TextColor="#00E676" FontAttributes="Bold" FontSize="20" HorizontalOptions="End"/>
                                <Label Text="{Binding Duration, StringFormat='{0:hh\\:mm\\:ss}'}" TextColor="#888" FontSize="12" HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Projekt_c4.ViewModels"
             x:Class="Projekt_c4.Views.SavedRoutesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#16181F">

    <ContentPage.BindingContext>
        <viewmodels:MainViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *">
        <Label Grid.Row="0" Text="Zapisane Trasy" FontSize="26" FontAttributes="Bold" TextColor="White" Margin="20,40,20,10"/>

        <!-- Włączona detekcja kliknięć (SelectionMode) -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Workouts}" SelectionMode="Single" SelectionChanged="OnWorkoutSelected" Margin="20,0,20,0">

            <!-- Widok pustej listy (EmptyView) -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15" Margin="30,100,30,0">
                    <Label Text="🏃‍♂️💨" FontSize="70" HorizontalOptions="Center" />
                    <Label Text="Brak zapisanych tras" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    <Label Text="Załóż buty, wyjdź na zewnątrz i zrób swój pierwszy trening! Twoje przebiegnięte trasy i wyniki pojawią się właśnie tutaj. Powodzenia! 💪"
                           FontSize="15" TextColor="#AAAAAA" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineHeight="1.3"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5,0,10" Padding="20" CornerRadius="15" BackgroundColor="#1A1D24" BorderColor="Transparent">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="White"/>

                            <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                                <Label Text="Dystans:" TextColor="#888" FontSize="14"/>
                                <Label Text="{Binding DistanceKm, StringFormat='{0:F2} km'}" TextColor="#00E676" FontAttributes="Bold" FontSize="14"/>
                                <Label Text="|" TextColor="#555" />
                                <Label Text="Czas:" TextColor="#888" FontSize="14"/>
                                <Label Text="{Binding Duration, StringFormat='{0:hh\\:mm\\:ss}'}" TextColor="#00E676" FontAttributes="Bold" FontSize="14"/>
                            </HorizontalStackLayout>

                            <Label Text="{Binding Date, StringFormat='Data: {0:dd.MM.yyyy HH:mm}'}" TextColor="#888" FontSize="12" Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projekt_c4.Views.SettingsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#16181F">

    <Grid RowDefinitions="Auto, *">
        <!-- GÓRNY PASEK Z PRZYCISKIEM POWROTU -->
        <Grid Grid.Row="0" Margin="15,40,15,15" ColumnDefinitions="Auto, *">
            <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#1A1D24" Padding="0" HasShadow="False" BorderColor="Transparent">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Frame.GestureRecognizers>
                <Label Text="←" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="20" FontAttributes="Bold"/>
            </Frame>
            <Label Grid.Column="1" Text="Ustawienia Konta" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" FontSize="20" Margin="-40,0,0,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10,20,40" Spacing="15">

                <Grid HorizontalOptions="Center" Margin="0,0,0,20">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChangeProfilePictureTapped" />
                    </Grid.GestureRecognizers>
                    <Frame WidthRequest="100" HeightRequest="100" CornerRadius="50" BackgroundColor="#222731" Padding="0" HasShadow="False" BorderColor="Transparent">
                        <Grid>
                            <Label x:Name="ProfileEmoji" Text="👤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="50"/>
                            <Image x:Name="ProfileImage" Aspect="AspectFill" IsVisible="False" />
                        </Grid>
                    </Frame>
                    <Frame WidthRequest="100" HeightRequest="100" CornerRadius="50" BackgroundColor="#80000000" Padding="0" HasShadow="False" BorderColor="Transparent" IsVisible="True">
                        <Label Text="Zmień zdjęcie" TextColor="White" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    </Frame>
                </Grid>

                <Label Text="Dane osobowe" TextColor="#00E676" FontAttributes="Bold" Margin="0,10,0,0"/>
                <Border StrokeShape="RoundRectangle 15" BackgroundColor="#222731" Padding="15,0" StrokeThickness="0">
                    <Entry x:Name="FirstNameEntry" Placeholder="Imię" TextColor="White" BackgroundColor="Transparent"/>
                </Border>
                <Border StrokeShape="RoundRectangle 15" BackgroundColor="#222731" Padding="15,0" StrokeThickness="0">
                    <Entry x:Name="LastNameEntry" Placeholder="Nazwisko" TextColor="White" BackgroundColor="Transparent"/>
                </Border>
                <Border StrokeShape="RoundRectangle 15" BackgroundColor="#222731" Padding="15,0" StrokeThickness="0">
                    <Entry x:Name="EmailEntry" Placeholder="Adres e-mail" TextColor="White" Keyboard="Email" BackgroundColor="Transparent"/>
                </Border>

                <Label Text="Zabezpieczenia" TextColor="#00E676" FontAttributes="Bold" Margin="0,10,0,0"/>
                <Border StrokeShape="RoundRectangle 15" BackgroundColor="#222731" Padding="15,0" StrokeThickness="0">
                    <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="Nowe hasło (pozostaw puste by nie zmieniać)" TextColor="White" BackgroundColor="Transparent"/>
                </Border>

                <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                    <CheckBox x:Name="UseBiometricsCheckbox" Color="#00E676" />
                    <Label Text="Użyj odcisku palca do logowania" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Text="Preferencje biegowe" TextColor="#00E676" FontAttributes="Bold" Margin="0,10,0,0"/>
                <Border StrokeShape="RoundRectangle 15" BackgroundColor="#222731" Padding="15,0" StrokeThickness="0">
                    <Entry x:Name="StepGoalEntry" Keyboard="Numeric" Placeholder="Dzienny cel kroków" TextColor="White" BackgroundColor="Transparent"/>
                </Border>

                <Button Text="ZAPISZ ZMIANY" CornerRadius="25" HeightRequest="55" BackgroundColor="#00E676" TextColor="Black" FontAttributes="Bold" Margin="0,20,0,0" Clicked="OnSaveClicked"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
